rules_version = '2';

// Forge security rules.
// Every user owns exactly one document tree: users/{uid}/** — nobody else can
// read or write it. AI usage counters are written only by the Cloud Function
// (Admin SDK bypasses rules) so clients cannot reset their own budget.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /backups/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /mocks/{mockId} {
        allow read, write: if isOwner(uid);
      }

      match /aiCache/{key} {
        allow read, write: if isOwner(uid);
      }

      match /diagrams/{diagramId} {
        allow read, write: if isOwner(uid);
      }

      match /aiUsage/{day} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }
  }
}
