# Copy this file to .env and fill in your values.
# Only public Firebase web config lives here. The Anthropic API key is a
# Cloud Functions secret (see functions/README) and never reaches the browser.

# Firebase config (required — Firebase console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional: talk to the local Functions emulator (npm --prefix functions run serve)
# VITE_USE_FUNCTIONS_EMULATOR=true

# Optional: App Check. The reCAPTCHA v3 site key (starts with "6L") enables it.
# For local development, put a debug token registered in the Firebase console in
# .env.local (it is only used by the dev server, never in production builds).
# VITE_RECAPTCHA_SITE_KEY=6L...
# VITE_APPCHECK_DEBUG_TOKEN=...
